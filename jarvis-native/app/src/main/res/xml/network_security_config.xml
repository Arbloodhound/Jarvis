<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the phone's own loopback: that is the laptop bridge, reached through
     the USB cable with `adb reverse tcp:8787 tcp:8787`. Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

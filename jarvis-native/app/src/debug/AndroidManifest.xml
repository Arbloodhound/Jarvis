<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into DEBUG builds only. The on-device benchmark (tools/bench.sh); release APKs
     carry neither this receiver nor its class. Exported so `adb shell am broadcast` can reach
     it, but only a sender holding DUMP may: the adb shell has it, ordinary apps do not.
     The accelerator probe (tools/accel-probe.sh) is the same arrangement. Its
     uses-native-library line lets the debug app try to load the vendor's OpenCL (targetSdk 31+
     apps can't otherwise reach vendor public libraries); required="false" so a phone without
     it still installs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.agent.jarvis.bench.BenchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.agent.jarvis.BENCH"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.agent.jarvis.bench.AccelProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.agent.jarvis.ACCEL_PROBE"/>
            </intent-filter>
        </receiver>
        <!-- "Jarvis Tests": the same probe, benchmark and a 10-question brain test run from
             the phone itself, for testers with no adb. Its own launcher icon, debug only. -->
        <activity
            android:name="com.agent.jarvis.bench.TestKitActivity"
            android:exported="true"
            android:label="Jarvis Tests"
            android:taskAffinity="com.agent.jarvis.tests"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
    </application>
</manifest>

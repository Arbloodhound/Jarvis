<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into DEBUG builds only. The on-device benchmark (tools/bench.sh); release APKs
     carry neither this receiver nor its class. Exported so `adb shell am broadcast` can reach
     it, but only a sender holding DUMP may: the adb shell has it, ordinary apps do not.
     The accelerator probe (tools/accel-probe.sh) is the same arrangement. Its
     uses-native-library line lets the debug app try to load the vendor's OpenCL (targetSdk 31+
     apps can't otherwise reach vendor public libraries); required="false" so a phone without
     it still installs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.agent.ultra.bench.BenchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.agent.ultra.BENCH"/>
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.agent.ultra.bench.AccelProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.agent.ultra.ACCEL_PROBE"/>
            </intent-filter>
        </receiver>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
    </application>
</manifest>

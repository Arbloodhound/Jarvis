<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into DEBUG builds only. The on-device benchmark (tools/bench.sh); release APKs
     carry neither this receiver nor its class. Exported so `adb shell am broadcast` can reach
     it, but only a sender holding DUMP may: the adb shell has it, ordinary apps do not. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="com.agent.ultra.bench.BenchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.agent.ultra.BENCH"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>

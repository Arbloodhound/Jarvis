{
  "expo": {
    "name": "Agent Ultra",
    "slug": "agent-ultra",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agent-ultra",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agent.ultra"
    },
    "android": {
      "package": "com.agent.ultra",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "SEND_SMS",
        "CAMERA",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "REQUEST_INSTALL_PACKAGES",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "QUERY_ALL_PACKAGES",
        "CALL_PHONE",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.WRITE_SECURE_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-background-fetch",
      "expo-task-manager",
      "expo-speech-recognition",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Agent Ultra to access your contacts"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agent Ultra to access the camera"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Agent Ultra to access your photos",
          "savePhotosPermission": "Allow Agent Ultra to save photos"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Agent Ultra to access your location",
          "locationWhenInUsePermission": "Allow Agent Ultra to access your location"
        }
      ],
      "./plugins/withAgentNative",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "dfa4d070-7a45-4741-864e-cff511bc45ff"
      }
    }
  }
}
